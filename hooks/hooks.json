{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/server/codex-host.js", "statusMessage": "Activating local RSI session context" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/server/codex-host.js", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/server/codex-host.js", "timeout": 3 }] }
    ]
  }
}
